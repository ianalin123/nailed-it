# Copy to .env.local (gitignored) or export in your shell. Never commit real values.

# River training API key (https://console.river.ai). Read from the environment only.
RIVER_API_KEY=

# Optional: on-prem River endpoint. Leave empty for River Cloud.
RIVER_ENDPOINT=

# Base model for SFT and RL. Check `client.get_capabilities()` for what your key can use.
RIVER_BASE_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
