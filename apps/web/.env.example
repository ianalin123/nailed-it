# Room server host, without protocol. Local dev: localhost:8787
NEXT_PUBLIC_ROOM_HOST=localhost:8787
# Party name override. Leave empty to use the shared ROOM_PARTY constant from @nailed-it/protocol ("room").
NEXT_PUBLIC_ROOM_PARTY=
# Set to 1 to play against a simulated in-browser room with fake players (no server needed).
NEXT_PUBLIC_ROOM_MOCK=0
